{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    { "source": "/functions", "destination": "/functions/", "permanent": true },
    { "source": "/:room(ti-te|ni-ne|fi-fe|si-se)", "destination": "/functions/:room", "permanent": true },
    { "source": "/:room(ti-te|ni-ne|fi-fe|si-se).html", "destination": "/functions/:room", "permanent": true }
  ],
  "rewrites": [{ "source": "/((?!functions/|assets/).*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/((?!functions/).*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ]
}
